//- Все примеси в этом файле должны начинаться c имени блока (form)
//- ВНИМАНИЕ: в файле две примеси

mixin form(mods)
  //- Принимает:
  //-   mods    {string} - список модификаторов
  //- Вызов:
    +form
      +fieldset
        +field-text({ attrs: { name: "name", placeholder: "ФИО", autocomplete: "off" } })
        +field-text({ attrs: { name: "phone", placeholder: "+7 ( )", autocomplete: "off", type: "tel" } })
        +field-text({ attrs: { name: "email", placeholder: "Электронная почта", autocomplete: "off", type: "email" } })
        +field-file({ helpText: "(в формате.doc,.docx,.pdf,.rtf, не более 5 Мб)", attrs: { name: "file", multiple: true }, text: { selectText: "Прикрепите файл", nothingText: "Ничего не выбрано", flesSelectedText: "Выбрано файлов:" } })
        +field-text({ isTextarea: true, attrs: { name: "comment", placeholder: "Опишите реакцию на препарат" } })
        +field-checkbox([{ title: "Настоящим выражаю согласие на обработку указанных мною персональных данных. С политикой конфиденциальности АО «Органика», в отношении обработки и защиты персональных данных ознакомлен (а).", subtitle: "Полученные от вас персональные данные будут носить конфиденциальный характер и, в соответствии с положениями Федерального закона № 152-ФЗ от 27.07.2006 г. «О защите персональных данных», не могут быть раскрыты третьим лицам без вашего письменного согласия, если иное не установлено законодательством РФ. Настоящее согласие может быть отозвано посредством направления письма по адресу электронной почты: <a href='mailto:inform@organica.su'>inform@organica.su</a>", attrs: { name: "check0", checked: true } }])
      +fieldaction
        +btn('Отправить', 'main')(type="submit")

  -
    // список модификаторов
    var allMods = '';
    if(typeof(mods) !== 'undefined' && mods) {
      var modsList = mods.split(',');
      for (var i = 0; i < modsList.length; i++) {
        allMods = allMods + ' form--' + modsList[i].trim();
      }
    }

  form.form(class=allMods, autocomplete="off")&attributes(attributes)
    block

mixin fieldset(mods)
  //- Принимает:
  //-   mods    {string} - список модификаторов
  //- Вызов:
    +fieldset('mod')
      +field-text({
        helpText: 'Подсказка',
        attrs: {
          placeholder: 'Пример'
        }
      })

  -
    // список модификаторов
    var allMods = '';
    if(typeof(mods) !== 'undefined' && mods) {
      var modsList = mods.split(',');
      for (var i = 0; i < modsList.length; i++) {
        allMods = allMods + ' form--' + modsList[i].trim();
      }
    }

  .form__fieldset(class=allMods)&attributes(attributes)
    block

mixin fieldaction(mods)
  .form__action
    block
